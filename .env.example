# Copy this file to .env and fill in real values.
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the client at build time.

# Supabase (database + storage)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI provider for transcription / OCR / task extraction.
# NOTE: Do NOT ship a secret API key inside the mobile bundle in production.
# Route AI calls through a Supabase Edge Function / your own backend and keep
# the key server-side. The variable below is only for local prototyping.
EXPO_PUBLIC_AI_API_BASE_URL=https://api.openai.com/v1
EXPO_PUBLIC_AI_API_KEY=your-ai-api-key

# Feature flag: when false, the app uses local mock AI functions (no network).
EXPO_PUBLIC_USE_REAL_AI=false
