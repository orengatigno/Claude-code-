# Copy this file to .env and fill in real values, then restart Expo with: npx expo start -c
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the client at build time.

# ---------------------------------------------------------------------------
# AI provider — required for REAL Hebrew transcription + task extraction.
# Uses an OpenAI-compatible API: Whisper for speech-to-text, a chat model for
# task extraction. Get a key at https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
EXPO_PUBLIC_USE_REAL_AI=true
EXPO_PUBLIC_AI_API_BASE_URL=https://api.openai.com/v1
EXPO_PUBLIC_AI_API_KEY=sk-your-openai-key-here

# Optional model overrides (defaults shown).
EXPO_PUBLIC_TRANSCRIPTION_MODEL=whisper-1
EXPO_PUBLIC_EXTRACTION_MODEL=gpt-4o-mini

# NOTE: For a private single-user build the key lives in the app bundle, which
# is fine. Before sharing the app, move these calls behind a Supabase Edge
# Function so the key stays server-side.

# ---------------------------------------------------------------------------
# Supabase (optional) — database + file storage. Leave blank to run fully local
# (tasks persist on-device via AsyncStorage).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
